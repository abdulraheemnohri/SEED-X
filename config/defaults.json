  },
  "memory": {
    "systemReserveBytes": 805306368,
    "modelRamMultiplier": 1.5,
    "maxImportedModelBytes": 8589934592
  },
  "ui": {
    "theme": "dark",
    "compactMode": false,
    "showAdvancedSettings": false
  },
  "donations": {
    "enabled": false,
    "provider": "GitHub Sponsors",
    "url": "https://github.com/sponsors/abdulraheemnohri"
  }
}
