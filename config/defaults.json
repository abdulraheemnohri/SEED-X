{
  "schemaVersion": 1,
  "privacy": {
    "onlineFallbackEnabled": false,
    "allowLocalHttp": false,
    "sendDiagnostics": false,
    "retainChatHistory": true
  },
  "routing": {
    "strategy": "local-first",
    "automaticFallback": false,
    "requireConfirmationForCloud": true
